<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aisaas.chat.mapper.ChatMessageMapper">

    <resultMap id="BaseResultMap" type="com.aisaas.chat.entity.ChatMessage">
        <id column="id" property="id"/>
        <result column="conversation_id" property="conversationId"/>
        <result column="user_id" property="userId"/>
        <result column="message_type" property="messageType"/>
        <result column="content_type" property="contentType"/>
        <result column="content" property="content"/>
        <result column="original_content" property="originalContent"/>
        <result column="parent_id" property="parentId"/>
        <result column="reply_to_id" property="replyToId"/>
        <result column="model" property="model"/>
        <result column="model_version" property="modelVersion"/>
        <result column="input_tokens" property="inputTokens"/>
        <result column="output_tokens" property="outputTokens"/>
        <result column="total_tokens" property="totalTokens"/>
        <result column="cost" property="cost"/>
        <result column="generate_time" property="generateTime"/>
        <result column="first_token_latency" property="firstTokenLatency"/>
        <result column="edit_status" property="editStatus"/>
        <result column="edited_at" property="editedAt"/>
        <result column="edit_count" property="editCount"/>
        <result column="regenerate_count" property="regenerateCount"/>
        <result column="regenerate_from_id" property="regenerateFromId"/>
        <result column="status" property="status"/>
        <result column="error_msg" property="errorMsg"/>
        <result column="attachments" property="attachments"/>
        <result column="citation_ids" property="citationIds"/>
        <result column="extras" property="extras"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="is_deleted" property="isDeleted"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, conversation_id, user_id, message_type, content_type, content, original_content,
        parent_id, reply_to_id, model, model_version, input_tokens, output_tokens, total_tokens,
        cost, generate_time, first_token_latency, edit_status, edited_at, edit_count,
        regenerate_count, regenerate_from_id, status, error_msg, attachments, citation_ids,
        extras, created_at, updated_at, is_deleted
    </sql>

    <select id="selectMessagePage" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM chat_message
        WHERE is_deleted = 0
        <if test="conversationId != null">
            AND conversation_id = #{conversationId}
        </if>
        <if test="messageType != null">
            AND message_type = #{messageType}
        </if>
        ORDER BY created_at DESC
    </select>

    <select id="selectBatchIdsWithDeleted" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM chat_message
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

</mapper>
